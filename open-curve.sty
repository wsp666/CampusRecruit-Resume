%   % Section headings already provide trailing space; no leading gap here.
%   \noindent
%   \begin{minipage}[t]{0.78\linewidth}%
%     \raggedright{#1}%
%   \end{minipage}\hfill
%   \begin{minipage}[t]{0.20\linewidth}%
%     \raggedleft\color{OpenCurveMuted}#2%
%   \end{minipage}%\par%\vspace{0.1em}%
% }
\newcommand{\cventry}[2]{%
  \noindent
  #1%
  \hfill
  {\color{OpenCurveMuted}#2}%
  \par
}
\newcommand{\cvpaper}[2]{%
  \par\noindent%\hangindent=2.8em\hangafter=1%
  \makebox[2.8em][l]{\bfseries\color{OpenCurvePrimary}#1}#2\par
  % \vspace{0.16em}%
}
